# Пример конфига Nginx для dbthub.ru
# Путь к проекту: /var/www/dbt (корень репозитория)
# 1. Соберите фронт: cd frontend && npm run build
# 2. Скопируйте этот файл: cp nginx-dbthub.conf.example /etc/nginx/sites-available/dbthub.ru
# 3. Подставьте свой сокет PHP (php8.1-fpm.sock или php8.2-fpm.sock)
# 4. Включите сайт: ln -s /etc/nginx/sites-available/dbthub.ru /etc/nginx/sites-enabled/
# 5. nginx -t && systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name dbthub.ru www.dbthub.ru;

    # Редирект на HTTPS (раскомментируйте после настройки SSL)
    # return 301 https://$server_name$request_uri;
    # }
    # server {
    # listen 443 ssl http2;
    # listen [::]:443 ssl http2;
    # server_name dbthub.ru www.dbthub.ru;
    # ssl_certificate /etc/letsencrypt/live/dbthub.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/dbthub.ru/privkey.pem;

    # Фронтенд (Vue SPA) — статика из собранного dist
    root /var/www/dbt/frontend/dist;
    index index.html;

    # API — все запросы /api/* отдаём в Yii2 (web/index.php)
    location /api {
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /var/www/dbt/web/index.php;
        fastcgi_param REQUEST_URI $request_uri;
        fastcgi_param DOCUMENT_ROOT /var/www/dbt/web;
        include fastcgi_params;
    }

    # Публичные загрузки из Yii (аватары, фото карточек/тестов)
    location ^~ /uploads/ {
        alias /var/www/dbt/web/uploads/;
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public";
    }

    # Новый раздел обучения: Vue SPA
    location ^~ /learning {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }

    # Старые Yii-вьюхи Гуру закрыты
    location ^~ /guru {
        return 410;
    }

    # Фронт: SPA — для остальных путей отдаём index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Кэш для статики фронта
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
