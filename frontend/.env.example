# URL бэкенда (Yii2 REST API). Для dev с proxy оставьте пустым или http://localhost:8080
VITE_API_URL=http://localhost:8080

# URL страниц Гуру (создать карточку/тест). Если SPA и PHP на одном домене — оставьте пустым (будет использован origin API).
# Иначе укажите базовый URL приложения Yii, например: https://ваш-сайт.com или https://ваш-сайт.com/backend
# VITE_GURU_BACKEND_URL=

# Публичный VAPID-ключ для Web Push (base64url). Если не задан, браузер может отказать в подписке.
# VITE_VAPID_PUBLIC_KEY=

# Ключ API 2ГИС для «Аналитики»: MapGL + геокодер (https://platform.2gis.ru/ ). Только в этом файле frontend/.env, имя строго VITE_2GIS_API_KEY — после изменения перезапустите vite (npm run dev).
# VITE_2GIS_API_KEY=
